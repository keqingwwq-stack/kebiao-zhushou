<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="粘贴 ICS 日历、课表文字，或从电脑端导出的 JSON。"
        android:textColor="@color/tx2"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etInput"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card"
        android:gravity="top|start"
        android:hint="周一 1-2节 高等数学 教二-105 张三 1-16周"
        android:inputType="textMultiLine"
        android:padding="10dp"
        android:textColor="@color/tx1"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPaste"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:text="粘贴"
            android:textAllCaps="false"
            android:textColor="@color/tx2"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnParse"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:text="解析预览"
            android:textAllCaps="false"
            android:textColor="@color/accent"
            android:textSize="13sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card">

        <TextView
            android:id="@+id/tvPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:textColor="@color/tx1"
            android:textSize="12sp"
            android:text="（还没有解析结果）" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnApply"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_primary"
            android:text="替换课表"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnMerge"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:text="追加"
            android:textAllCaps="false"
            android:textColor="@color/accent"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>